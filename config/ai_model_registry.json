  "default_reviewer_aliases": [
    "agy-gemini-3.5-flash-high",
    "claude-opus-4.8"
  ],
  "fallback_policy": {
    "on_quota_exhausted": [
      {
        "from_quota_group": "agy-gemini-shared",
        "phases": ["planning", "review"],
        "to": "claude:opus-4.8"
      },
      {
        "from_quota_group": "agy-gemini-shared",
        "phases": ["code", "implementation"],
        "to": "claude:sonnet-4.6"
      },
      {
        "from_quota_group": "agy-third-party-shared",
        "phases": ["planning", "review"],
        "to": "claude:opus-4.8"
      },
      {
        "from_quota_group": "agy-third-party-shared",
        "phases": ["code", "implementation"],
        "to": "claude:sonnet-4.6"
      }
    ],
    "fail_closed_for_unregistered_models": true
  },
  "quota_error_patterns": [
    "quota",
    "limit exceeded",
    "exhausted",
    "rate limit",
    "429",
    "resource_exhausted",
    "RESOURCE_EXHAUSTED"
  ]
}
